[steam.exe]
BOX64_ENV=WINEARGS=-noshaders -nooverlay -nocrashmonitor -no-shared-textures -cef-disable-gpu -cef-disable-gpu-compositing -cef-disable-gpu-sandbox -cef-disable-d3d11 -cef-disable-sandbox -no-cef-sandbox -cef-disable-seccomp-sandbox -cef-single-process -single_core
BOX64_ENV1=WINEDLLOVERRIDES=gameoverlayrenderer,gameoverlayrenderer64,gameoverlayui.exe,gameoverlayui64.exe,x86launcher.exe,x64launcher.exe,dxsetup.exe=d
BOX64_ENV2=DXVK_ASYNC=0

[steamwebhelper.exe]
BOX64_DYNAREC_STRONGMEM=1
BOX64_ENV=WINEDLLOVERRIDES=dxgi=b
BOX64_ENV1=DXVK_ASYNC=0

[farcry3.exe]
BOX64_ENV=WINE_DO_NOT_OPEN_SC_MANAGER=1

[farcry3_d3d11.exe]
BOX64_ENV=WINE_DO_NOT_OPEN_SC_MANAGER=1

[FarCry4.exe]
BOX64_ENV=WINVERSION=winxp

[watch_dogs.exe]
BOX64_ENV=WINVERSION=winxp

[ffxiiiimg.exe]
BOX64_ENV=WINEARGS=-FullScreenMode=Force -Shadow=512 -Msaa=2

[kof13_win32_Release.exe]
BOX64_ENV1=WINEDLLOVERRIDES=quartz=d

[DXMD.exe]
BOX64_ENV=WINEVMEMMAXSIZE=16384

[rage.exe]
BOX64_ENV=ZINK_CONTEXT_MODE=base

[rage64.exe]
BOX64_ENV=ZINK_CONTEXT_MODE=base

[jasp.exe]
BOX64_ENV=MESA_EXTENSION_MAX_YEAR=2002

[MOHAA.exe]
BOX64_ENV=MESA_EXTENSION_MAX_YEAR=2002

[moh_spearhead.exe]
BOX64_ENV=MESA_EXTENSION_MAX_YEAR=2002

[moh_breakthrough.exe]
BOX64_ENV=MESA_EXTENSION_MAX_YEAR=2002

[WolfSP.exe]
BOX64_ENV=MESA_EXTENSION_MAX_YEAR=2002

[DOOMx64.exe]
BOX64_ENV=WINEARGS=+r_renderAPI 1

[ff7remake_.exe]
BOX64_ENV=WINEARGS=-dx11

[Discipl2.exe]
BOX64_ENV=WINEDLLOVERRIDES=ddraw,d3d8=b

[MotoRacer.exe]
BOX64_ENV1=WINEDLLOVERRIDES=winmm=n,b

[Chrono Trigger.exe]
BOX64_ENV1=WINEDLLOVERRIDES=winegstreamer=d

[flatout.exe]
BOX64_DYNAREC_BIGBLOCK=3
BOX64_DYNAREC_CALLRET=1

[sonicgenerations.exe]
BOX64_ENV=WINEESYNC=0

[valkyria.exe]
BOX64_ENV=WINEESYNC=0

[prototypef.exe]
BOX64_DYNAREC_SAFEFLAGS=2
BOX64_ENV=WINEDLLOVERRIDES=xaudio2_0,xaudio2_1,xaudio2_2,xaudio2_3,xaudio2_4,xaudio2_5,xaudio2_6,xaudio2_7=b

[prototype2.exe]
BOX64_ENV=WINEDLLOVERRIDES=xaudio2_0,xaudio2_1,xaudio2_2,xaudio2_3,xaudio2_4,xaudio2_5,xaudio2_6,xaudio2_7=b

#.NET Framework installers
[*dotnetfx35*]
BOX64_EXIT=1

[*dotnetfx40*]
BOX64_EXIT=1

[*ndp452-kb*]
BOX64_EXIT=1

[*ndp462-kb*]
BOX64_EXIT=1

# MS Office
[WINWORD.EXE]
BOX64_DYNAREC_SAFEFLAGS=2

[EXCEL.EXE]
BOX64_DYNAREC_SAFEFLAGS=2

[POWERPNT.EXE]
BOX64_DYNAREC_SAFEFLAGS=2

# Java Runtime Environment installers
[*jre-*]
BOX64_ENV=WINEARGS=/s

# Java Runtime Environment
[javaw.exe]
BOX64_ENV=WINEDLLOVERRIDES=ddraw,d3d9=b